{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tatwa-electronics-visualizer",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_ROOM",
        "class_name": "SessionRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionRoom"]
    }
  ],
  "vars": {
    "ORATION_PUBLIC_KEY": "70588826-0a19-4c4f-abdf-6de6c720d793",
    "ORATION_AGENT_ID": "128f59b2-7f37-4e1f-badd-f18c7a2a2287",
    "TOOL_WEBHOOK_SECRET": "tatwa_internal_secret_2026",
    "ALLOWED_ORIGIN": "*"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
